{
  "name": "tien-bao-paint-rag",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "vars": { "SITE_ORIGIN": "https://sontienbao-v7.vercel.app" },
  "ratelimits": [
    { "name": "PAINT_RATE", "namespace_id": "86142", "simple": { "limit": 4, "period": 60 } }
  ]
}
